+impl Inner {
+    /// Decode with prompt-lookup drafts: each step feeds the last sampled token plus the drafted tokens in one batch and
+    /// samples every position in turn; a draft token is kept only while it equals what the sampler picks. Batched logits
+    /// differ from one-token logits at rounding level, so the text can differ from plain decoding (greedy: 4 of 10
+    /// answers stayed identical even with every draft rejected). The KV cache then drops the rejected positions.
+    fn decode_ngram(&mut self, mut hist: Vec<i32>, smpl: *mut sys::llama_sampler, p: &GenParams, on_token: &mut dyn FnMut(&str) -> bool, st: &mut GenStats) -> Result<()> {
+        let mem = unsafe { sys::llama_get_memory(self.ctx) };
+        let mut n_past = unsafe { sys::llama_memory_seq_pos_max(mem, 0) } + 1;
+        let mut batch = unsafe { sys::llama_batch_init(DRAFT_MAX as i32 + 1, 0, 1) };
+        // Verify batches would run on the prefill pool and its thread count; switching pools every step costs more
+        // than the extra threads give, so the decode pool runs both until the answer ends.
+        let nt = unsafe { sys::llama_n_threads(self.ctx) };
+        unsafe {
+            if !self.threadpool.is_null() {
+                sys::llama_attach_threadpool(self.ctx, self.threadpool, self.threadpool);
+            }
+            sys::llama_set_n_threads(self.ctx, nt, nt);
+        }
+        let mut pending: Vec<u8> = Vec::new();
+        let (mut steps, mut drafted, mut accepted) = (0u32, 0u32, 0u32);
+        // Emits one token; false ends the answer (end token, length limit or cancel).
+        let mut emit = |this: &Inner, tok: i32, hist: &mut Vec<i32>, st: &mut GenStats| -> bool {
+            if unsafe { sys::llama_vocab_is_eog(this.vocab(), tok) } {
+                return false;
+            }
+            st.gen_tokens += 1;
+            if st.gen_tokens > p.max_tokens {
+                st.truncated = true;
+                return false;
+            }
+            hist.push(tok);
+            this.piece(tok, &mut pending);
+            let valid = match std::str::from_utf8(&pending) {
+                Ok(_) => pending.len(),
+                Err(e) if e.error_len().is_none() => e.valid_up_to(),
+                Err(_) => pending.len(),
+            };
+            if valid > 0 {
+                let s = String::from_utf8_lossy(&pending[..valid]).into_owned();
+                pending.drain(..valid);
+                if !on_token(&s) {
+                    return false;
+                }
+            }
+            true
+        };
+        let result = (|| -> Result<()> {
+            let mut id_last = unsafe { sys::llama_sampler_sample(smpl, self.ctx, -1) };
+            let mut want = 2usize;
+            loop {
+                if !emit(self, id_last, &mut hist, st) {
+                    return Ok(());
+                }
+                let left = (p.max_tokens.saturating_sub(st.gen_tokens)) as usize;
+                let draft: Vec<i32> = ngram_draft(&hist, want.min(left)).to_vec();
+                unsafe {
+                    let b = &mut batch;
+                    b.n_tokens = 0;
+                    for (i, &tok) in std::iter::once(&id_last).chain(draft.iter()).enumerate() {
+                        *b.token.add(i) = tok;
+                        *b.pos.add(i) = n_past + i as i32;
+                        *b.n_seq_id.add(i) = 1;
+                        **b.seq_id.add(i) = 0;
+                        *b.logits.add(i) = 1;
+                        b.n_tokens += 1;
+                    }
+                }
+                let rc = unsafe { sys::llama_decode(self.ctx, batch) };
+                ensure!(rc == 0, "llama_decode failed ({rc})");
+                steps += 1;
+                drafted += draft.len() as u32;
+                let mut acc = 0usize;
+                let next = loop {
+                    let s = unsafe { sys::llama_sampler_sample(smpl, self.ctx, acc as i32) };
+                    if acc < draft.len() && s == draft[acc] {
+                        acc += 1;
+                        if !emit(self, s, &mut hist, st) {
+                            return Ok(());
+                        }
+                    } else {
+                        break s;
+                    }
+                };
+                accepted += acc as u32;
+                n_past += 1 + acc as i32;
+                ensure!(unsafe { sys::llama_memory_seq_rm(mem, 0, n_past, -1) }, "the memory cannot drop rejected drafts");
+                // At least 2 drafts: small batches cost little more than one token (see DRAFT_MAX).
+                want = (acc + 2).min(DRAFT_MAX);
+                id_last = next;
+            }
+        })();
+        unsafe {
+            sys::llama_batch_free(batch);
+            if !self.threadpool.is_null() {
+                sys::llama_attach_threadpool(self.ctx, self.threadpool, self.batch_pool);
+            }
+            sys::llama_set_n_threads(self.ctx, nt, self.batch_threads as i32);
+        }
+        if std::env::var_os("COMMONPLACE_NGRAM_LOG").is_some() {
+            eprintln!("ngram-spec: steps {steps} drafted {drafted} accepted {accepted} tokens/step {:.2}", (accepted + steps) as f64 / steps.max(1) as f64);
+        }
+        result
+    }
+}
