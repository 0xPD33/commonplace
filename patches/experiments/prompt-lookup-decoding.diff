+/// Longest prompt-lookup draft. On the Pixel 10 a 4-token prefill batch (llama-bench pp4) took about as long as one
+/// token; a verify also computes logits for every position, which this did not measure.
+const DRAFT_MAX: usize = 8;
+
+/// The tokens that followed the most recent earlier occurrence of the last three tokens of `hist`, else of the last
+/// two, at most `n`. The longer key drafts less often and right more often (MiniCPM5 RAG answers, desktop: 1.56 tokens
+/// per step against 1.52 with the two-token key alone).
+fn ngram_draft(hist: &[i32], n: usize) -> &[i32] {
+    let len = hist.len();
+    if n == 0 {
+        return &[];
+    }
+    for k in [3usize, 2] {
+        if len <= k {
+            continue;
+        }
+        let key = &hist[len - k..];
+        for i in (0..len - k).rev() {
+            if &hist[i..i + k] == key {
+                return &hist[i + k..(i + k + n).min(len)];
+            }
+        }
+    }
+    &[]
 }
 
