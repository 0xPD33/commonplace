+#ifndef GGML_USE_OPENMP
+// Pools that one thread runs one after the other (a speculative draft model and its target) must not busy-wait
+// against each other on shared cores: when a thread starts a graph on a different pool than its last one, it pauses
+// that last pool. Only a live pool with no graph in flight is paused, so no worker can miss a kicked-off graph; a
+// paused pool resumes at its next kickoff. The registry keeps a freed pool from being touched.
+#if defined(_MSC_VER)
+#define GGML_CPU_TLS __declspec(thread)
+#else
+#define GGML_CPU_TLS _Thread_local
+#endif
+#define GGML_CPU_MAX_LIVE_POOLS 64
+
+static struct ggml_threadpool * ggml_live_pools[GGML_CPU_MAX_LIVE_POOLS];
+static GGML_CPU_TLS struct ggml_threadpool * ggml_last_pool;
+
+static void ggml_threadpool_register(struct ggml_threadpool * tp, bool add) {
+    ggml_critical_section_start();
+    for (int i = 0; i < GGML_CPU_MAX_LIVE_POOLS; i++) {
+        if (ggml_live_pools[i] == (add ? NULL : tp)) {
+            ggml_live_pools[i] = add ? tp : NULL;
+            break;
+        }
+    }
+    ggml_critical_section_end();
+}
+
+static void ggml_threadpool_pause_previous(struct ggml_threadpool * cur) {
+    struct ggml_threadpool * prev = ggml_last_pool;
+    ggml_last_pool = cur;
+    if (prev == NULL || prev == cur) {
+        return;
+    }
+    ggml_critical_section_start();
+    for (int i = 0; i < GGML_CPU_MAX_LIVE_POOLS; i++) {
+        if (ggml_live_pools[i] == prev) {
+            ggml_mutex_lock(&prev->mutex);
+            if (!prev->pause && !atomic_load(&prev->busy)) {
+                prev->pause = true;
+                ggml_cond_broadcast(&prev->cond);
+            }
+            ggml_mutex_unlock(&prev->mutex);
+            break;
+        }
+    }
+    ggml_critical_section_end();
+}
+#endif
+
 void ggml_threadpool_free(struct ggml_threadpool* threadpool) {
     if (!threadpool) return;
 
+#ifndef GGML_USE_OPENMP
+    ggml_threadpool_register(threadpool, false);
+    if (ggml_last_pool == threadpool) {
+        ggml_last_pool = NULL;
+    }
+#endif
+
     const int n_threads = threadpool->n_threads;
 
 #ifndef GGML_USE_OPENMP
