+    float32x4_t m0 = vdupq_n_f32(-INFINITY), m1 = m0, m2 = m0, m3 = m0;
+    int i = 0;
+    for (; i + 16 <= n; i += 16) {
+        m0 = vmaxq_f32(m0, vld1q_f32(x + i));
+        m1 = vmaxq_f32(m1, vld1q_f32(x + i + 4));
+        m2 = vmaxq_f32(m2, vld1q_f32(x + i + 8));
+        m3 = vmaxq_f32(m3, vld1q_f32(x + i + 12));
+    }
+    float max = vmaxvq_f32(vmaxq_f32(vmaxq_f32(m0, m1), vmaxq_f32(m2, m3)));
+    for (; i < n; ++i) {
+        max = MAX(max, x[i]);
+    }
+    *s = max;
+#elif !defined(GGML_USE_ACCELERATE)
     float max = -INFINITY;
     for (int i = 0; i < n; ++i) {
         max = MAX(max, x[i]);
