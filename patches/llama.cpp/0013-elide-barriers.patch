+
+// Barrier elision between graph nodes. All threads take the same decision (it depends on the graph only):
+// - thread-0 chain: every node since the last barrier and the next one give all their work to thread 0 (one row,
+//   row-split op), so thread 0 runs them in order and the other threads have nothing to wait for;
+// - independence: the next node and every node since the last barrier are simple ops (static ith/nth split, no wdata,
+//   chunk counter or internal barrier) and their memory ranges do not overlap (no RAW, WAR or WAW).
+#define GGML_CPU_ELIDE_MAX 8
+
+struct ggml_cpu_range { const char * b; const char * e; };
+
+static bool ggml_cpu_plain_type(enum ggml_type t) {
+    return t == GGML_TYPE_F32 || t == GGML_TYPE_F16 || t == GGML_TYPE_BF16 || t == GGML_TYPE_I32;
+}
+
+static bool ggml_cpu_plain_srcs(const struct ggml_tensor * t) {
+    if (!ggml_cpu_plain_type(t->type)) {
+        return false;
+    }
+    for (int i = 0; i < GGML_MAX_SRC; i++) {
+        // GET_ROWS may read quantized rows: it dequantizes row by row, without scratch
+        if (t->src[i] && !ggml_cpu_plain_type(t->src[i]->type) && !(t->op == GGML_OP_GET_ROWS && i == 0)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool ggml_cpu_barrier_free_op(const struct ggml_tensor * t) {
+    switch (t->op) {
+        case GGML_OP_ADD: case GGML_OP_SUB: case GGML_OP_MUL: case GGML_OP_DIV: case GGML_OP_SCALE:
+        case GGML_OP_UNARY: case GGML_OP_GLU: case GGML_OP_GET_ROWS: case GGML_OP_CPY: case GGML_OP_DUP:
+        case GGML_OP_CONT: case GGML_OP_CONCAT: case GGML_OP_CLAMP: case GGML_OP_FILL: case GGML_OP_SUM_ROWS:
+        case GGML_OP_RMS_NORM: case GGML_OP_ARGSORT: case GGML_OP_SSM_CONV: case GGML_OP_SQR: case GGML_OP_SQRT:
+            return ggml_cpu_plain_srcs(t);
+        default:
+            return false;
+    }
+}
+
+// Tiny simple nodes run on thread 0 alone (nth = 1): splitting a few thousand values costs more in barriers than it
+// saves. The whitelisted ops split by rows or elements without cross-thread reductions, so results do not change.
+#define GGML_CPU_TINY_NODE 4096
+
+static bool ggml_cpu_tiny(const struct ggml_tensor * t) {
+    return ggml_nelements(t) <= GGML_CPU_TINY_NODE && ggml_cpu_barrier_free_op(t);
+}
+
+// true when only thread 0 does work: tiny nodes, and row-split ops (get_thread_range, dr = ceil(nr/nth), or
+// ith-strided rows) on one row
+static bool ggml_cpu_thread0_only(const struct ggml_tensor * t) {
+    if (!ggml_cpu_plain_srcs(t)) {
+        return false;
+    }
+    if (ggml_cpu_tiny(t)) {
+        return true;
+    }
+    switch (t->op) {
+        case GGML_OP_SUM_ROWS:
+            return true;
+        case GGML_OP_UNARY:
+            switch (ggml_get_unary_op(t)) {
+                case GGML_UNARY_OP_SIGMOID: case GGML_UNARY_OP_SILU: case GGML_UNARY_OP_EXP: case GGML_UNARY_OP_NEG:
+                case GGML_UNARY_OP_RELU: case GGML_UNARY_OP_TANH:
+                    return ggml_nrows(t->src[0]) == 1;
+                default:
+                    return false;
+            }
+        case GGML_OP_ADD: case GGML_OP_SUB: case GGML_OP_MUL: case GGML_OP_DIV: case GGML_OP_SCALE: case GGML_OP_GLU:
+        case GGML_OP_ARGSORT: case GGML_OP_CLAMP:
+            return ggml_nrows(t->src[0]) == 1 && ggml_nrows(t) == 1;
+        case GGML_OP_RMS_NORM:
+            return ggml_nrows(t->src[0]) == 1;
+        case GGML_OP_GET_ROWS:
+            return ggml_nelements(t->src[1]) == 1;
+        default:
+            return false;
+    }
+}
+
+static struct ggml_cpu_range ggml_cpu_range_of(const struct ggml_tensor * t) {
+    struct ggml_cpu_range r = { (const char *) t->data, (const char *) t->data + ggml_nbytes(t) };
+    return r;
+}
+
+static bool ggml_cpu_ranges_overlap(struct ggml_cpu_range a, const struct ggml_cpu_range * v, int n) {
+    for (int i = 0; i < n; i++) {
+        if (a.b < v[i].e && v[i].b < a.e) {
+            return true;
+        }
+    }
+    return false;
+}
