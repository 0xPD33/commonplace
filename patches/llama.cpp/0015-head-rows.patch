+void llama_context::set_head_extra_tokens(const llama_token * tokens, int32_t n_tokens) {
+    const auto & rows = model.head_rows;
+    head_extra.clear();
+    if (rows.empty()) {
+        return;
+    }
+    const int64_t n_embd_head = model.head_row_size*ggml_blck_size(model.head_type)/ggml_type_size(model.head_type);
+    FILE * f = nullptr;
+    for (int32_t i = 0; i < n_tokens; i++) {
+        const int32_t id = tokens[i];
+        if (id < 0 || std::binary_search(rows.begin(), rows.end(), id) ||
+                std::any_of(head_extra.begin(), head_extra.end(), [id](const auto & x) { return x.first == id; })) {
+            continue;
+        }
+        auto it = head_extra_rows.find(id);
+        if (it == head_extra_rows.end()) {
+            f = f ? f : fopen(model.head_path.c_str(), "rb");
+            std::vector<uint8_t> raw(model.head_row_size);
+            std::vector<float> row(n_embd_head);
+            if (!f || fseeko(f, model.head_offs + id*model.head_row_size, SEEK_SET) != 0 || fread(raw.data(), 1, raw.size(), f) != raw.size()) {
+                continue;
+            }
+            ggml_get_type_traits(model.head_type)->to_float(raw.data(), row.data(), n_embd_head);
+            it = head_extra_rows.emplace(id, std::move(row)).first;
+        }
+        head_extra.emplace_back(id, &it->second);
+    }
+    if (f) {
+        fclose(f);
+    }
+}
+
+void llama_head_extra_tokens(llama_context * ctx, const llama_token * tokens, int32_t n_tokens) {
+    ctx->set_head_extra_tokens(tokens, n_tokens);
+}
+
 void llama_set_n_threads(llama_context * ctx, int32_t n_threads, int32_t n_threads_batch) {
     ctx->set_n_threads(n_threads, n_threads_batch);
 }
